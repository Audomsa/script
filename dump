--==================================================
-- RENDER
--==================================================

local function render()

	local filter = string.lower(search.Text)

	local result = {}

	for _, line in ipairs(dumpLines) do

		if filter == ""
			or string.find(
				string.lower(line),
				filter,
				1,
				true
			) then

			table.insert(result, line)
		end
	end

	text.Text = table.concat(result, "\n")

	task.defer(function()

		output.CanvasSize = UDim2.fromOffset(
			0,
			text.AbsoluteSize.Y + 20
		)

	end)
end

--==================================================
-- DUMP FUNCTIONS
--==================================================

local function dumpTree(instance, depth, maxDepth)

	depth = depth or 0
	maxDepth = maxDepth or 5

	if depth > maxDepth then
		return
	end

	local indent = string.rep("  ", depth)

	addLine(
		indent
		.. "├─ "
		.. instance.Name
		.. " ["
		.. instance.ClassName
		.. "]"
	)

	for _, child in ipairs(instance:GetChildren()) do
		dumpTree(child, depth + 1, maxDepth)
	end
end

local function dumpWorkspace()

	clearData()

	addLine("========== WORKSPACE ==========")
	dumpTree(workspace, 0, 6)
	addLine("")
	addLine("========== END ==========")

	render()
end

local function dumpPlayers()

	clearData()

	addLine("========== PLAYERS ==========")

	for _, player in ipairs(Players:GetPlayers()) do

		addLine("")
		addLine("Player: " .. player.Name)
		addLine("DisplayName: " .. player.DisplayName)
		addLine("UserId: " .. player.UserId)

		if player.Team then
			addLine("Team: " .. player.Team.Name)
		else
			addLine("Team: None")
		end

		local character = player.Character

		if character then

			addLine("Character: " .. character.Name)

			local humanoid =
				character:FindFirstChildOfClass("Humanoid")

			if humanoid then

				addLine(
					"Health: "
					.. math.floor(humanoid.Health)
					.. "/"
					.. math.floor(humanoid.MaxHealth)
				)

			end

			local root =
				character:FindFirstChild("HumanoidRootPart")

			if root then
				addLine(
					"Position: "
					.. tostring(root.Position)
				)
			end

		else
			addLine("Character: None")
		end
	end

	addLine("")
	addLine("========== END ==========")

	render()
end

local function dumpRemotes()

	clearData()

	addLine("========== REMOTES ==========")

	local count = 0

	for _, instance in ipairs(game:GetDescendants()) do

		if instance:IsA("RemoteEvent")
			or instance:IsA("RemoteFunction") then

			count += 1

			addLine(
				"#"
				.. count
				.. " "
				.. instance:GetFullName()
				.. " ["
				.. instance.ClassName
				.. "]"
			)
		end
	end

	addLine("")
	addLine("Total: " .. count)
	addLine("========== END ==========")

	render()
end

local function dumpAttributes()

	clearData()

	addLine("========== ATTRIBUTES ==========")

	local count = 0

	for _, instance in ipairs(game:GetDescendants()) do

		local attributes = instance:GetAttributes()

		if next(attributes) then

			count += 1

			addLine("")
			addLine(instance:GetFullName())

			for name, value in pairs(attributes) do

				addLine(
					"  "
					.. name
					.. " = "
					.. tostring(value)
				)
			end
		end
	end

	addLine("")
	addLine("Instances: " .. count)
	addLine("========== END ==========")

	render()
end

local function dumpValues()

	clearData()

	addLine("========== VALUES ==========")

	local classes = {
		StringValue = true,
		IntValue = true,
		NumberValue = true,
		BoolValue = true,
		ObjectValue = true,
		Vector3Value = true,
		CFrameValue = true,
		Color3Value = true
	}

	local count = 0

	for _, instance in ipairs(game:GetDescendants()) do

		if classes[instance.ClassName] then

			count += 1

			local value = "?"

			pcall(function()
				value = tostring(instance.Value)
			end)

			addLine(
				instance:GetFullName()
				.. " = "
				.. value
			)
		end
	end

	addLine("")
	addLine("Total: " .. count)
	addLine("========== END ==========")

	render()
end

