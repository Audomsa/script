copyButton.MouseButton1Click:Connect(function()

	-- Clipboard access may be unavailable in normal Roblox clients.
	-- This attempts to copy when supported.

	if setclipboard then

		local filter = string.lower(search.Text)
		local result = {}

		for _, line in ipairs(dumpLines) do

			if filter == ""
				or string.find(
					string.lower(line),
					filter,
					1,
					true
				) then

				table.insert(result, line)
			end
		end

		setclipboard(table.concat(result, "\n"))

		copyButton.Text = "Copied!"

		task.delay(1.5, function()
			copyButton.Text = "Copy"
		end)

	else

		copyButton.Text = "Unavailable"

		task.delay(1.5, function()
			copyButton.Text = "Copy"
		end)

	end
end)

