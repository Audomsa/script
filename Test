local function createInput(labelText, value, y)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromOffset(30, 32)
	label.Position = UDim2.fromOffset(15, y)
	label.BackgroundTransparency = 1
	label.Text = labelText
	label.TextColor3 = Color3.fromRGB(180, 180, 180)
	label.TextSize = 14
	label.Font = Enum.Font.GothamBold
	label.Parent = main

	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, -65, 0, 32)
	box.Position = UDim2.fromOffset(50, y)
	box.BackgroundColor3 = Color3.fromRGB(44, 44, 51)
	box.TextColor3 = Color3.fromRGB(255, 255, 255)
	box.Text = tostring(value)
	box.TextSize = 13
	box.Font = Enum.Font.Code
	box.ClearTextOnFocus = false
	box.BorderSizePixel = 0
	box.Parent = main

	Instance.new("UICorner", box).CornerRadius =
		UDim.new(0, 5)

	return box
end

