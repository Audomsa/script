--========================================================
-- SCAN
--========================================================

local function scan()

	clearList()

	local root = getRoot()

	if not root then
		status.Text = "Character not ready"
		return
	end

	local found = 0

	-- พยายามหาโฟลเดอร์ Bases
	local bases = workspace:FindFirstChild("Bases")

	if bases then

		for _, base in ipairs(
			bases:GetChildren()
		) do

			local basePos = getPosition(base)

			if basePos then

				for _, obj in ipairs(
					base:GetDescendants()
				) do

					if obj:IsA("Model")
						or obj:IsA("BasePart") then

						local value =
							getValue(obj)

						local owner =
							getOwner(base)

						local pos =
							getPosition(obj)

						if pos then

							local distance =
								(root.Position - pos).Magnitude

							-- แสดงเฉพาะ object ที่มี
							-- Value / Price / Worth
							if obj:GetAttribute("Value")
								or obj:GetAttribute("Price")
								or obj:GetAttribute("Worth") then

								found += 1

								addResult(
									obj,
									owner,
									value,
									distance
								)
							end
						end
					end
				end
			end
		end

	else

		-- fallback:
		-- scan object ที่มี Value attribute
		for _, obj in ipairs(
			workspace:GetDescendants()
		) do

			if obj:GetAttribute("Value")
				or obj:GetAttribute("Price")
				or obj:GetAttribute("Worth") then

				local pos = getPosition(obj)

				if pos then

					local distance =
						(root.Position - pos).Magnitude

					found += 1

					addResult(
						obj,
						getOwner(obj),
						getValue(obj),
						distance
					)
				end
			end
		end
	end

	task.wait()

	list.CanvasSize =
		UDim2.fromOffset(
			0,
			layout.AbsoluteContentSize.Y + 15
		)

	status.Text =
		"Found "
		.. found
		.. " possible Brainrot(s)"

	status.TextColor3 =
		Color3.fromRGB(100,220,130)

	log(
		"Scan complete: "
		.. found
		.. " target(s)"
	)
end

