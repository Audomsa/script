-- Double-click selected target
-- เพื่อใช้ทดสอบ teleport ใน Studio
local function teleportSelected()

	if not selectedTarget then
		status.Text = "No target selected"
		return
	end

	local root = getRoot()
	local pos = getPosition(selectedTarget)

	if not root or not pos then
		return
	end

	root.CFrame =
		CFrame.new(
			pos + Vector3.new(0,3,0)
		)

	status.Text =
		"Moved to "
		.. selectedTarget.Name

	log(
		"Moved to "
		.. selectedTarget:GetFullName()
	)
end

--========================================================
-- RIGHT SHIFT = TELEPORT SELECTED
--========================================================

UserInputService.InputBegan:Connect(function(input,gpe)

	if gpe then
		return
	end

	if input.KeyCode == Enum.KeyCode.RightShift then
		teleportSelected()
	end
end)

--========================================================
-- DRAG
--========================================================

local dragging = false
local dragStart
local startPos

title.InputBegan:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1 then

		dragging = true

		dragStart =
			input.Position

		startPos =
			main.Position

		input.Changed:Connect(function()

			if input.UserInputState ==
				Enum.UserInputState.End then

				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)

	if not dragging then
		return
	end

	if input.UserInputType ==
		Enum.UserInputType.MouseMovement then

		local delta =
			input.Position - dragStart

		main.Position =
			UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,

				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
	end
end)

