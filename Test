--==============================================================
-- REMOTE ARGUMENT FORMATTER
--==============================================================

local function formatValue(value,depth,seen)

	depth = depth or 0
	seen = seen or {}

	if depth > 5 then
		return "<max depth>"
	end

	local t = typeof(value)

	if t == "nil"
		or t == "string"
		or t == "number"
		or t == "boolean" then

		return tostring(value)
	end

	if t == "Instance" then

		return "<Instance: "
			.. value:GetFullName()
			.. ">"
	end

	if t == "Vector3"
		or t == "Vector2"
		or t == "CFrame"
		or t == "Color3"
		or t == "UDim2" then

		return "<"
			.. t
			.. "> "
			.. tostring(value)
	end

	if t == "table" then

		if seen[value] then
			return "<circular>"
		end

		seen[value] = true

		local lines = {"{"}

		for key,item in pairs(value) do

			table.insert(
				lines,
				string.rep("  ",depth+1)
				.. tostring(key)
				.. " = "
				.. formatValue(
					item,
					depth+1,
					seen
				)
			)
		end

		table.insert(
			lines,
			string.rep("  ",depth)
			.. "}"
		)

		seen[value] = nil

		return table.concat(lines,"\n")
	end

	return tostring(value)
end

