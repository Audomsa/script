--==================================================
-- DUMP PLAYERS
--==================================================

local function dumpPlayers()

	print("================================")
	print("PLAYER DUMP")
	print("================================")

	for _, player in ipairs(Players:GetPlayers()) do

		print("Player:", player.Name)
		print("DisplayName:", player.DisplayName)
		print("UserId:", player.UserId)
		print("Team:", player.Team and player.Team.Name or "None")

		local character = player.Character

		if character then

			print("Character:", character.Name)

			local humanoid =
				character:FindFirstChildOfClass("Humanoid")

			if humanoid then
				print("Health:", humanoid.Health)
				print("MaxHealth:", humanoid.MaxHealth)
			end

			local root =
				character:FindFirstChild("HumanoidRootPart")

			if root then
				print("Position:", root.Position)
			end
		else
			print("Character: None")
		end

		print("-----------------------------")
	end

	print("========== END PLAYERS ==========")
end

--==================================================
-- DUMP REMOTES
--==================================================

local function dumpRemotes()

	print("================================")
	print("REMOTE DUMP")
	print("================================")

	local count = 0

	for _, instance in ipairs(game:GetDescendants()) do

		if instance:IsA("RemoteEvent")
			or instance:IsA("RemoteFunction") then

			count += 1

			print(
				"#"
				.. count
				.. " | "
				.. instance:GetFullName()
				.. " ["
				.. instance.ClassName
				.. "]"
			)
		end
	end

	print("Total Remotes:", count)

	print("========== END REMOTES ==========")
end

--==================================================
-- DUMP ATTRIBUTES
--==================================================

local function dumpAttributes()

	print("================================")
	print("ATTRIBUTE DUMP")
	print("================================")

	local count = 0

	for _, instance in ipairs(game:GetDescendants()) do

		local attributes = instance:GetAttributes()

		if next(attributes) then

			count += 1

			print("Instance:", instance:GetFullName())

			for name, value in pairs(attributes) do

				print(
					"  ",
					name,
					"=",
					value
				)
			end
		end
	end

	print("Instances with attributes:", count)

	print("========== END ATTRIBUTES ==========")
end

--==================================================
-- DUMP VALUES
--==================================================

local function dumpValues()

	print("================================")
	print("VALUE OBJECT DUMP")
	print("================================")

	local valueClasses = {
		"StringValue",
		"IntValue",
		"NumberValue",
		"BoolValue",
		"ObjectValue",
		"Vector3Value",
		"CFrameValue",
		"Color3Value"
	}

	local lookup = {}

	for _, className in ipairs(valueClasses) do
		lookup[className] = true
	end

	local count = 0

	for _, instance in ipairs(game:GetDescendants()) do

		if lookup[instance.ClassName] then

			count += 1

			local value

			pcall(function()
				value = instance.Value
			end)

			print(
				instance:GetFullName(),
				"=",
				value
			)
		end
	end

	print("Total ValueObjects:", count)

	print("========== END VALUES ==========")
end

