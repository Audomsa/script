--==============================================================
-- SHOW INSTANCE
--==============================================================

local function showInstance(obj)

	selectedInstance = obj

	clearInfo()

	if not obj then
		return
	end

	infoTitle.Text =
		obj.Name

	addInfo(
		"ClassName",
		obj.ClassName
	)

	addInfo(
		"Name",
		obj.Name
	)

	addInfo(
		"FullName",
		obj:GetFullName()
	)

	addInfo(
		"Parent",
		obj.Parent
			and obj.Parent:GetFullName()
			or "nil"
	)

	addInfo(
		"Children",
		#obj:GetChildren()
	)

	-- Attributes

	local attributes =
		obj:GetAttributes()

	if next(attributes) then

		local lines = {}

		for key,value in pairs(attributes) do

			table.insert(
				lines,
				tostring(key)
				.. " = "
				.. tostring(value)
			)
		end

		table.sort(lines)

		addInfo(
			"Attributes",
			table.concat(lines,"\n")
		)

	else

		addInfo(
			"Attributes",
			"<none>"
		)
	end

	-- BasePart

	if obj:IsA("BasePart") then

		addInfo(
			"Position",
			tostring(obj.Position)
		)

		addInfo(
			"Size",
			tostring(obj.Size)
		)

		addInfo(
			"Anchored",
			obj.Anchored
		)

	elseif obj:IsA("Model") then

		addInfo(
			"Pivot",
			tostring(
				obj:GetPivot().Position
			)
		)
	end

	task.defer(function()

		infoList.CanvasSize =
			UDim2.fromOffset(
				0,
				infoLayout.AbsoluteContentSize.Y
				+ 10
			)

	end)
end

--==============================================================
-- FILTER
--==============================================================

local function matches(obj)

	if currentFilter ~= "All" then

		if obj.ClassName ~= currentFilter then
			return false
		end
	end

	if searchText == "" then
		return true
	end

	local query =
		string.lower(searchText)

	local name =
		string.lower(obj.Name)

	local full =
		string.lower(
			obj:GetFullName()
		)

	return string.find(
		name,
		query,
		1,
		true
	) ~= nil

	or string.find(
		full,
		query,
		1,
		true
	) ~= nil
end

--==============================================================
-- RENDER INSTANCE LIST
--==============================================================

local function renderInstances()

	for _, child in ipairs(
		instanceList:GetChildren()
	) do

		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local count = 0

	for _, obj in ipairs(instances) do

		if count >= MAX_INSTANCES then
			break
		end

		if matches(obj) then

			count += 1

			local button =
				Instance.new("TextButton")

			button.Size =
				UDim2.new(1,-5,0,30)

			button.BackgroundColor3 =
				Color3.fromRGB(29,29,35)

			button.Text =
				"[" .. obj.ClassName .. "] "
				.. obj:GetFullName()

			button.TextColor3 =
				Color3.fromRGB(210,210,210)

			button.TextSize = 9
			button.Font = Enum.Font.Code

			button.TextXAlignment =
				Enum.TextXAlignment.Left

			button.BorderSizePixel = 0
			button.Parent = instanceList

			Instance.new("UICorner",button)
				.CornerRadius =
					UDim.new(0,4)

			button.MouseButton1Click:Connect(
				function()
					showInstance(obj)
				end
			)
		end
	end

	task.defer(function()

		instanceList.CanvasSize =
			UDim2.fromOffset(
				0,
				instanceLayout.AbsoluteContentSize.Y
				+ 10
			)

	end)

	logStatus.Text =
		"Showing "
		.. count
		.. " / "
		.. #instances
		.. " Instances | Remote Logs: "
		.. #logs
end

--==============================================================
-- DUMP
--==============================================================

local function dump(root)

	instances = {}

	table.insert(
		instances,
		root
	)

	for _, obj in ipairs(
		root:GetDescendants()
	) do

		table.insert(
			instances,
			obj
		)

		if #instances >= MAX_INSTANCES then
			break
		end
	end

	renderInstances()

	print(
		"[DEBUG DUMP]",
		root:GetFullName(),
		#instances
	)
end

