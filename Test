--============================================================
-- INSTANCE INFO
--============================================================

local function showInstance(obj)

	selectedInstance = obj

	clearInfo()

	if not obj then
		infoTitle.Text =
			"Instance Properties"

		return
	end

	infoTitle.Text =
		obj.Name

	addInfo(
		"ClassName",
		obj.ClassName
	)

	addInfo(
		"Name",
		obj.Name
	)

	addInfo(
		"FullName",
		obj:GetFullName()
	)

	addInfo(
		"Parent",
		obj.Parent and obj.Parent:GetFullName()
			or "nil"
	)

	-- Attributes
	local attrs = obj:GetAttributes()

	if next(attrs) then

		local lines = {}

		for key,value in pairs(attrs) do

			table.insert(
				lines,
				tostring(key)
				.. " = "
				.. tostring(value)
			)
		end

		table.sort(lines)

		addInfo(
			"Attributes",
			table.concat(lines,"\n")
		)

	else

		addInfo(
			"Attributes",
			"<none>"
		)
	end

	-- Children
	local children = obj:GetChildren()

	addInfo(
		"Children",
		#children
	)

	-- Position
	if obj:IsA("BasePart") then

		addInfo(
			"Position",
			tostring(obj.Position)
		)

		addInfo(
			"Size",
			tostring(obj.Size)
		)

	elseif obj:IsA("Model") then

		addInfo(
			"Pivot",
			tostring(
				obj:GetPivot().Position
			)
		)
	end

	task.defer(function()

		infoScroll.CanvasSize =
			UDim2.fromOffset(
				0,
				infoLayout.AbsoluteContentSize.Y
				+ 10
			)

	end)
end

--============================================================
-- RESULT FILTER
--============================================================

local function matches(obj)

	if currentClassFilter ~= "All" then

		if obj.ClassName
			~= currentClassFilter then

			return false
		end
	end

	if currentFilter == "" then
		return true
	end

	local query =
		string.lower(currentFilter)

	local name =
		string.lower(obj.Name)

	local fullName =
		string.lower(
			obj:GetFullName()
		)

	return string.find(
		name,
		query,
		1,
		true
	) ~= nil

	or string.find(
		fullName,
		query,
		1,
		true
	) ~= nil
end

--============================================================
-- RENDER
--============================================================

function renderResults()

	for _, child in ipairs(
		resultScroll:GetChildren()
	) do

		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local shown = 0

	for _, obj in ipairs(results) do

		if shown >= MAX_RESULTS then
			break
		end

		if matches(obj) then

			shown += 1

			local button =
				Instance.new("TextButton")

			button.Size =
				UDim2.new(1,-6,0,32)

			button.BackgroundColor3 =
				Color3.fromRGB(30,30,36)

			button.Text =
				"[" .. obj.ClassName .. "] "
				.. obj:GetFullName()

			button.TextColor3 =
				Color3.fromRGB(205,205,205)

			button.TextSize = 10
			button.Font = Enum.Font.Code
			button.TextXAlignment =
				Enum.TextXAlignment.Left

			button.BorderSizePixel = 0
			button.Parent = resultScroll

			Instance.new("UICorner",button)
				.CornerRadius =
					UDim.new(0,4)

			button.MouseButton1Click:Connect(
				function()

					showInstance(obj)

					status.Text =
						"Selected: "
						.. obj:GetFullName()
				end
			)
		end
	end

	task.defer(function()

		resultScroll.CanvasSize =
			UDim2.fromOffset(
				0,
				resultLayout.AbsoluteContentSize.Y
				+ 10
			)

	end)

	status.Text =
		"Showing "
		.. shown
		.. " / "
		.. #results
end

--============================================================
-- DUMP ROOT
--============================================================

local function dumpRoot(root)

	results = {}

	status.Text =
		"Dumping " .. root.Name .. "..."

	-- root itself
	table.insert(
		results,
		root
	)

	for _, obj in ipairs(
		root:GetDescendants()
	) do

		table.insert(
			results,
			obj
		)

		if #results >= MAX_RESULTS then
			break
		end
	end

	renderResults()

	status.Text =
		"Dump complete: "
		.. #results
		.. " instances"

	print(
		"[DUMPER]",
		root:GetFullName(),
		"Instances:",
		#results
	)
end

