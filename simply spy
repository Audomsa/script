                end
                local argsStr=table.concat(argStrs,", ")
                addLog({
                    label="◀ "..path..(argsStr~="" and "  ("..argsStr..")" or ""),
                    remote=path, method="OnClientEvent", argsStr=argsStr,
                    code="-- OnClientEvent (server→client)",
                    color=Color3.fromRGB(100,180,255),
                })
            end)
        end)
    end
end

