-- ================================================
--  FORMAT args → Lua code
-- ================================================
local function valueToLua(v)
    local t = typeof(v)
    if t=="string" then return string.format("%q", v)
    elseif t=="number" then return tostring(v)
    elseif t=="boolean" then return tostring(v)
    elseif t=="Instance" then return 'game:GetService("'..v.ClassName..'") --[['..v:GetFullName()..']]'
    elseif t=="Vector3" then return string.format("Vector3.new(%g,%g,%g)",v.X,v.Y,v.Z)
    elseif t=="CFrame" then return string.format("CFrame.new(%g,%g,%g)",v.X,v.Y,v.Z)
    elseif t=="table" then return "{--[[table]]}"
    else return tostring(v):sub(1,40) end
end

local function buildCode(remotePath, method, args)
    local argStrs={}
    for _, v in ipairs(args) do table.insert(argStrs, valueToLua(v)) end
    local argStr=table.concat(argStrs,", ")
    if method=="FireServer" then
        return string.format('game:GetService("ReplicatedStorage"):FindFirstChild("%s"):FireServer(%s)',
            remotePath:match("[^%.]+$") or remotePath, argStr)
    elseif method=="InvokeServer" then
        return string.format('game:GetService("ReplicatedStorage"):FindFirstChild("%s"):InvokeServer(%s)',
            remotePath:match("[^%.]+$") or remotePath, argStr)
    end
    return "-- " .. method .. " " .. remotePath
end

-- ================================================
--  HOOK __namecall
-- ================================================
local blocked_methods = {RunService=true, Heartbeat=true, RenderStepped=true}
local spam_count={}
local MAX_SPAM=5

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if (method=="FireServer" and self:IsA("RemoteEvent")) or
       (method=="InvokeServer" and self:IsA("RemoteFunction")) then

        local path = self:GetFullName()

        -- skip excluded / blocked
        if excludeList[path] or blockList[path] then
            return oldNamecall(self,...)
        end

        -- spam filter
        spam_count[path] = (spam_count[path] or 0) + 1
        if spam_count[path] > MAX_SPAM then
            task.delay(3, function() spam_count[path]=0 end)
            return oldNamecall(self,...)
        end

        local argStrs={}
        for _, v in ipairs(args) do
            table.insert(argStrs, typeof(v).."="..tostring(v):sub(1,25))
        end
        local argsStr=table.concat(argStrs,", ")
        local code=buildCode(path, method, args)

        local color
        if method=="FireServer" then color=Color3.fromRGB(100,255,160)
        else color=Color3.fromRGB(255,200,80) end

        local label=(method=="FireServer" and "▶ " or "⚡ ")..path
        if argsStr~="" then label=label.."  ("..argsStr..")" end

        addLog({
            label=label,
            remote=path,
            method=method,
            argsStr=argsStr,
            code=code,
            color=color,
        })
    end

    return oldNamecall(self,...)
end)

