                for _, a in ipairs(args) do
                    table.insert(parts, typeof(a).."="..tostring(a):sub(1,25))
                end
                addLine("◀ OnClientEvent: " .. v:GetFullName(), Color3.fromRGB(100,180,255))
                if #parts > 0 then
                    addLine("  Args: " .. table.concat(parts,", "), Color3.fromRGB(160,190,255))
                end
            end)
        end)
    end
end

