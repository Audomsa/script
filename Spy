-- ================================================
--  1. ดัก ProximityPrompt ทุกตัว
-- ================================================
local function hookPrompt(prompt)
    prompt.Triggered:Connect(function(player)
        addLine("🟢 ProxPrompt.Triggered: " .. prompt:GetFullName(), Color3.fromRGB(100,255,150))
        addLine("   ActionText: " .. prompt.ActionText .. " | ObjectText: " .. prompt.ObjectText, Color3.fromRGB(160,220,160))
        addLine("   Player: " .. tostring(player), Color3.fromRGB(140,200,140))
    end)
end

for _, v in ipairs(game:GetDescendants()) do
    if v:IsA("ProximityPrompt") then pcall(hookPrompt, v) end
end
game.DescendantAdded:Connect(function(v)
    if v:IsA("ProximityPrompt") then task.wait(0.1); pcall(hookPrompt, v) end
end)

-- ================================================
--  2. Hook __namecall (ดัก FireServer/InvokeServer ทุกแบบ)
-- ================================================
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if method == "FireServer" and self:IsA("RemoteEvent") then
        addLine("▶ FireServer: " .. self:GetFullName(), Color3.fromRGB(100,255,180))
        local parts = {}
        for _, v in ipairs(args) do
            table.insert(parts, typeof(v) .. "=" .. tostring(v):sub(1,30))
        end
        if #parts > 0 then
            addLine("  Args: " .. table.concat(parts,", "), Color3.fromRGB(160,220,180))
        end

    elseif method == "InvokeServer" and self:IsA("RemoteFunction") then
        addLine("⚡ InvokeServer: " .. self:GetFullName(), Color3.fromRGB(255,200,80))
        local parts = {}
        for _, v in ipairs(args) do
            table.insert(parts, typeof(v) .. "=" .. tostring(v):sub(1,30))
        end
        if #parts > 0 then
            addLine("  Args: " .. table.concat(parts,", "), Color3.fromRGB(220,200,150))
        end

    elseif method == "FireAllClients" or method == "FireClient" then
        addLine("◀ " .. method .. ": " .. self:GetFullName(), Color3.fromRGB(100,180,255))
    end

    return oldNamecall(self, ...)
end)

