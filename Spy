local function addLine(text, color, bg_color)
    lineNum = lineNum + 1
    color = color or Color3.fromRGB(210,200,255)

    local row = Instance.new("Frame",scroll)
    row.Size = UDim2.new(1,-4,0,20)
    row.BackgroundColor3 = bg_color or Color3.fromRGB(0,0,0)
    row.BackgroundTransparency = bg_color and 0.7 or 1
    row.BorderSizePixel = 0; row.LayoutOrder = lineNum
    Instance.new("UICorner",row).CornerRadius=UDim.new(0,3)

    local lbl = Instance.new("TextLabel",row)
    lbl.Size = UDim2.new(1,-8,1,0); lbl.Position = UDim2.new(0,4,0,0)
    lbl.BackgroundTransparency = 1; lbl.Text = text; lbl.TextColor3 = color
    lbl.TextSize = 11; lbl.Font = Enum.Font.Code
    lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.TextWrapped = true

    scroll.CanvasSize = UDim2.new(0,0,0,lineNum*22+10)
    -- auto scroll ลงล่าง
    scroll.CanvasPosition = Vector2.new(0, math.max(0, lineNum*22 - scroll.AbsoluteSize.Y))
end

local function formatArgs(args)
    local parts = {}
    for i, v in ipairs(args) do
        local t = typeof(v)
        local str
        if t == "string" then
            str = '"' .. tostring(v):sub(1,40) .. '"'
        elseif t == "Instance" then
            str = "[" .. v.ClassName .. "] " .. v.Name
        elseif t == "table" then
            str = "{table}"
        else
            str = tostring(v):sub(1,30)
        end
        parts[i] = str
    end
    return table.concat(parts, ", ")
end

