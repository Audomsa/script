-- ================================================
--  HOOK RemoteEvent ทุกตัว
-- ================================================
local hooked = {}

local function hookRemote(remote)
    if hooked[remote] then return end
    hooked[remote] = true

    if remote:IsA("RemoteEvent") then
        -- ดัก FireServer
        local oldFire = remote.FireServer
        remote.FireServer = function(self, ...)
            local args = {...}
            eventCount = eventCount + 1
            counterLbl.Text = "Listening... (" .. eventCount .. " events)"

            addLine("▶ FireServer: " .. remote:GetFullName(),
                Color3.fromRGB(100,255,150), Color3.fromRGB(20,60,30))
            local argStr = formatArgs(args)
            if argStr ~= "" then
                addLine("  Args: " .. argStr, Color3.fromRGB(180,220,180))
            end
            return oldFire(self, ...)
        end

        -- ดัก OnClientEvent (server ส่งมา)
        remote.OnClientEvent:Connect(function(...)
            local args = {...}
            eventCount = eventCount + 1
            counterLbl.Text = "Listening... (" .. eventCount .. " events)"

            addLine("◀ OnClientEvent: " .. remote:GetFullName(),
                Color3.fromRGB(100,180,255), Color3.fromRGB(20,40,70))
            local argStr = formatArgs(args)
            if argStr ~= "" then
                addLine("  Args: " .. argStr, Color3.fromRGB(160,200,255))
            end
        end)

    elseif remote:IsA("RemoteFunction") then
        local oldInvoke = remote.InvokeServer
        remote.InvokeServer = function(self, ...)
            local args = {...}
            eventCount = eventCount + 1
            counterLbl.Text = "Listening... (" .. eventCount .. " events)"

            addLine("⚡ InvokeServer: " .. remote:GetFullName(),
                Color3.fromRGB(255,200,80), Color3.fromRGB(60,50,10))
            local argStr = formatArgs(args)
            if argStr ~= "" then
                addLine("  Args: " .. argStr, Color3.fromRGB(220,200,150))
            end
            return oldInvoke(self, ...)
        end
    end
end

-- Hook remotes ที่มีอยู่แล้ว
local function hookAll()
    for _, v in ipairs(game:GetDescendants()) do
        if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
            pcall(hookRemote, v)
        end
    end
end

