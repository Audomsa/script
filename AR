-- Helpers
local function getHP(p)
    local c = p.Character; if not c then return 0,100 end
    local h = c:FindFirstChildOfClass("Humanoid")
    if h then return math.floor(h.Health), math.floor(h.MaxHealth) end
    return 0,100
end
local function getHPColor(hp,max)
    local p = hp/math.max(max,1)
    if p>0.6 then return Color3.fromRGB(80,255,80)
    elseif p>0.3 then return Color3.fromRGB(255,200,0)
    else return Color3.fromRGB(255,60,60) end
end
local function getDist(root)
    local c = LocalPlayer.Character; if not c then return 0 end
    local r = c:FindFirstChild("HumanoidRootPart"); if not r then return 0 end
    return math.floor((root.Position-r.Position).Magnitude)
end
local function isDead(p)
    local c = p.Character; if not c then return true end
    local h = c:FindFirstChildOfClass("Humanoid")
    return not h or h.Health <= 0
end

