-- ESP
local espData={}
local function removeESP(p)
    local d=espData[p]; if not d then return end
    pcall(function() d.hl:Destroy() end); pcall(function() d.bb:Destroy() end); espData[p]=nil
end
local function updateESP(p,isTarget)
    if not Config.ESPEnabled then removeESP(p); return end
    local char=p.Character; if not char or isDead(p) then removeESP(p); return end
    local root=char:FindFirstChild("HumanoidRootPart"); if not root then return end
    local d=espData[p]
    if not d then
        local hl=Instance.new("Highlight"); hl.FillTransparency=0.5; hl.OutlineTransparency=0
        hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
        local bb=Instance.new("BillboardGui"); bb.Size=UDim2.new(0,130,0,54)
        bb.StudsOffset=Vector3.new(0,3.5,0); bb.AlwaysOnTop=true
        local n1=Instance.new("TextLabel",bb); n1.Size=UDim2.new(1,0,0,18); n1.BackgroundTransparency=1
        n1.Text=p.Name; n1.TextColor3=Color3.fromRGB(255,255,255); n1.TextSize=13
        n1.Font=Enum.Font.GothamBold; n1.TextStrokeTransparency=0.3; n1.TextStrokeColor3=Color3.fromRGB(0,0,0)
        local h1=Instance.new("TextLabel",bb); h1.Size=UDim2.new(1,0,0,16); h1.Position=UDim2.new(0,0,0,18)
        h1.BackgroundTransparency=1; h1.TextSize=11; h1.Font=Enum.Font.GothamSemibold
        h1.TextStrokeTransparency=0.3; h1.TextStrokeColor3=Color3.fromRGB(0,0,0)
        local d1=Instance.new("TextLabel",bb); d1.Size=UDim2.new(1,0,0,14); d1.Position=UDim2.new(0,0,0,34)
        d1.BackgroundTransparency=1; d1.TextSize=10; d1.Font=Enum.Font.Gotham
        d1.TextColor3=Color3.fromRGB(180,180,220); d1.TextStrokeTransparency=0.3
        d1.TextStrokeColor3=Color3.fromRGB(0,0,0)
        d={hl=hl,bb=bb,hpLbl=h1,distLbl=d1}; espData[p]=d
    end
    if d.hl.Parent~=char then d.hl.Adornee=char; d.hl.Parent=char end
    if d.bb.Parent~=root then d.bb.Adornee=root; d.bb.Parent=root end
    local hp,maxHp=getHP(p)
    d.hpLbl.Text="❤  "..hp.." / "..maxHp; d.hpLbl.TextColor3=getHPColor(hp,maxHp)
    d.distLbl.Text="📍 "..getDist(root).." studs"
    if isTarget then
        d.hl.FillColor=Color3.fromRGB(255,210,0); d.hl.OutlineColor=Color3.fromRGB(255,255,0); d.hl.FillTransparency=0.2
    else
        d.hl.FillColor=Color3.fromRGB(220,50,50); d.hl.OutlineColor=Color3.fromRGB(255,255,255); d.hl.FillTransparency=0.5
    end
end

