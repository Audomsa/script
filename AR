local lastMousePos = Vector2.new(0,0)

RunService.RenderStepped:Connect(function(dt)
    local vp = Camera.ViewportSize
    local r = Config.FOV
    Circle.Size = UDim2.new(0,r*2,0,r*2)
    Circle.Position = UDim2.new(0,vp.X/2-r,0,vp.Y/2-r)
    Circle.Visible = Config.AimEnabled

    local center = Vector2.new(vp.X/2, vp.Y/2)
    local best, bestDist = nil, math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if isDead(p) then removeESP(p); continue end
        local char = p.Character; if not char then removeESP(p); continue end
        local root = char:FindFirstChild("HumanoidRootPart"); if not root then continue end
        if Config.AimEnabled then
            local sp, on = Camera:WorldToViewportPoint(root.Position)
            if on then
                local dist = (Vector2.new(sp.X,sp.Y)-center).Magnitude
                if dist < Config.FOV and dist < bestDist then best,bestDist=root,dist end
            end
        end
        updateESP(p, root==best)
    end

    if Config.AimEnabled and best then
        -- คำนวณ screen position ของ target
        local sp = Camera:WorldToViewportPoint(best.Position)
        local targetScreen = Vector2.new(sp.X, sp.Y)
        local delta = targetScreen - center

        -- ขยับ mouse ไปหา target ทีละนิด (smooth)
        local moveX = delta.X * Config.Smoothness
        local moveY = delta.Y * Config.Smoothness

        -- ลอง VirtualInputManager ก่อน
        local ok = pcall(function()
            VIM:SendMouseMoveEvent(
                math.floor(center.X + moveX),
                math.floor(center.Y + moveY),
                false, game
            )
        end)

        -- ถ้าไม่ได้ลอง mousemoverel
        if not ok then
            pcall(function()
                mousemoverel(moveX, moveY)
            end)
        end
    end
end)

