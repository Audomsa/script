--========================================================
-- REFRESH LIST
--========================================================

local function refreshList()

	clearTargetUI()

	for _, target in ipairs(TARGETS) do

		if target.Object
			and target.Object.Parent then

			createTargetButton(
				target.Base,
				target.Object
			)
		end
	end

	task.defer(function()

		list.CanvasSize =
			UDim2.fromOffset(
				0,
				listLayout.AbsoluteContentSize.Y
				+ 12
			)
	end)
end

--========================================================
-- SCAN
--========================================================

local function scan()

	BASES = {}
	TARGETS = {}
	SELECTED = nil

	clearTargetUI()

	log("========== SCAN ==========")

	local folder =
		getBasesFolder()

	if not folder then

		status.Text =
			"Workspace.Bases not found"

		log(
			"[ERROR] Workspace.Bases missing"
		)

		return
	end

	for _, base in ipairs(
		folder:GetChildren()
	) do

		table.insert(
			BASES,
			base
		)

		local owner =
			base:GetAttribute(
				"OwnerUserId"
			)

		local locked =
			base:GetAttribute(
				"Locked"
			)

		log(
			"[BASE] "
			.. base.Name
			.. " | Owner="
			.. tostring(owner)
			.. " | Locked="
			.. tostring(locked)
		)

		-- ไม่เลือกบ้านตัวเอง
		if base ~= getMyBase() then

			for _, brainrot in ipairs(
				getBrainrots(base)
			) do

				local stealable =
					brainrot:GetAttribute(
						"Stealable"
					)

				if stealable ~= false then

					table.insert(
						TARGETS,
						{
							Base = base,
							Object = brainrot
						}
					)

					log(
						"   └─ "
						.. brainrot.Name
					)
				end
			end
		end
	end

	local myBase =
		getMyBase()

	if myBase then

		HOME_POSITION =
			getBasePosition(
				myBase
			)

		log(
			"[HOME] "
			.. myBase.Name
		)
	end

	refreshList()

	status.Text =
		"Bases: "
		.. #BASES
		.. " | Targets: "
		.. #TARGETS

	status.TextColor3 =
		Color3.fromRGB(
			100,
			220,
			130
		)

	log(
		"Targets found: "
		.. #TARGETS
	)

	log("========== END ==========")
end

--========================================================
-- RETURN HOME
--========================================================

local function returnHome()

	local root =
		getRoot()

	if not root then
		return
	end

	if not HOME_POSITION then

		local base =
			getMyBase()

		if base then
			HOME_POSITION =
				getBasePosition(base)
		end
	end

	if not HOME_POSITION then

		status.Text =
			"Home not found"

		return
	end

	root.CFrame =
		CFrame.new(
			HOME_POSITION
			+ Vector3.new(0,3,0)
		)

	status.Text =
		"Returned Home"

	log("[RETURN] Home")
end

--========================================================
-- TEST COLLECT
--========================================================

local function testCollect(target)

	if not target then
		return
	end

	local object =
		target.Object

	if not object
		or not object.Parent then

		log(
			"[ERROR] Target no longer exists"
		)

		return
	end

	local root =
		getRoot()

	if not root then
		return
	end

	local position =
		getPosition(object)

	if not position then
		return
	end

	log(
		"[MOVE] "
		.. object.Name
	)

	root.CFrame =
		CFrame.new(
			position
			+ Vector3.new(0,3,0)
		)

	task.wait(0.5)

	-- จำลองการเก็บ
	object:SetAttribute(
		"Stealable",
		false
	)

	object:SetAttribute(
		"CollectedBy",
		Player.UserId
	)

	log(
		"[COLLECT] "
		.. object.Name
	)

	task.wait(0.4)

	returnHome()
end

--========================================================
-- AUTO TEST
--========================================================

local function autoTest()

	if RUNNING then
		return
	end

	RUNNING = true

	status.Text =
		"Auto Test..."

	status.TextColor3 =
		Color3.fromRGB(
			255,
			200,
			80
		)

	-- Scan ใหม่ก่อน
	scan()

	if #TARGETS == 0 then

		status.Text =
			"No targets"

		RUNNING = false

		return
	end

	for i = 1,#TARGETS do

		if not RUNNING then
			break
		end

		local target =
			TARGETS[i]

		if target.Object
			and target.Object.Parent then

			SELECTED = target

			status.Text =
				"Testing "
				.. target.Object.Name

			testCollect(target)

			task.wait(0.5)
		end
	end

	RUNNING = false

	refreshList()

	status.Text =
		"Auto Test Finished"

	status.TextColor3 =
		Color3.fromRGB(
			100,
			220,
			130
		)

	log("========== FINISHED ==========")
end

--========================================================
-- BUTTON EVENTS
--========================================================

scanButton.MouseButton1Click:Connect(
	function()

		if not RUNNING then
			scan()
		end
	end
)

autoButton.MouseButton1Click:Connect(
	function()

		if SELECTED and not RUNNING then

			RUNNING = true

			task.spawn(
				function()

					testCollect(
						SELECTED
					)

					RUNNING = false

					refreshList()
				end
			)

		elseif not RUNNING then

			task.spawn(autoTest)
		end
	end
)

returnButton.MouseButton1Click:Connect(
	returnHome
)

stopButton.MouseButton1Click:Connect(
	function()

		RUNNING = false

		status.Text =
			"Stopped"

		status.TextColor3 =
			Color3.fromRGB(
				255,
				100,
				100
			)

		log("[STOP]")
	end
)

--========================================================
-- DRAG
--========================================================

local dragging = false
local dragStart
local startPosition

title.InputBegan:Connect(
	function(input)

		if input.UserInputType
			== Enum.UserInputType.MouseButton1
			or input.UserInputType
			== Enum.UserInputType.Touch then

			dragging = true

			dragStart =
				input.Position

			startPosition =
				main.Position

			input.Changed:Connect(
				function()

					if input.UserInputState
						== Enum.UserInputState.End then

						dragging = false
					end
				end
			)
		end
	end
)

UserInputService.InputChanged:Connect(
	function(input)

		if not dragging then
			return
		end

		if input.UserInputType
			== Enum.UserInputType.MouseMovement
			or input.UserInputType
			== Enum.UserInputType.Touch then

			local delta =
				input.Position
				- dragStart

			main.Position =
				UDim2.new(
					startPosition.X.Scale,
					startPosition.X.Offset
						+ delta.X,

					startPosition.Y.Scale,
					startPosition.Y.Offset
						+ delta.Y
				)
		end
	end
)

