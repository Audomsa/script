--========================================================
-- HELPERS
--========================================================

local function getCharacter()
	return Player.Character
end

local function getRoot()
	local character = getCharacter()

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local function getBasesFolder()
	return workspace:FindFirstChild("Bases")
end

local function getPosition(instance)
	if not instance then
		return nil
	end

	if instance:IsA("BasePart") then
		return instance.Position
	end

	if instance:IsA("Model") then
		return instance:GetPivot().Position
	end

	local part = instance:FindFirstChildWhichIsA(
		"BasePart",
		true
	)

	return part and part.Position
end

local function getBasePosition(base)
	local spawn = base:FindFirstChild(
		"Spawn",
		true
	)

	return getPosition(spawn) or getPosition(base)
end

local function getMyBase()
	local folder = getBasesFolder()

	if not folder then
		return nil
	end

	for _, base in ipairs(folder:GetChildren()) do

		if base:GetAttribute("OwnerUserId")
			== Player.UserId then

			return base
		end
	end

	return nil
end

local function getBrainrotFolder(base)
	return base:FindFirstChild(
		"Brainrots",
		true
	)
end

local function getBrainrots(base)
	local folder = getBrainrotFolder(base)

	if not folder then
		return {}
	end

	return folder:GetChildren()
end

