-- LOG
--========================================================

local logs = {}

local function log(message)

	table.insert(
		logs,
		tostring(message)
	)

	if #logs > 150 then
		table.remove(logs,1)
	end

	logText.Text =
		table.concat(logs,"\n")

	task.defer(function()

		logBox.CanvasSize =
			UDim2.fromOffset(
				0,
				logText.AbsoluteSize.Y + 10
			)

		logBox.CanvasPosition =
			Vector2.new(
				0,
				math.max(
					0,
					logText.AbsoluteSize.Y
					- logBox.AbsoluteSize.Y
				)
			)
	end)
end

