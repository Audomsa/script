-- OUTPUT FUNCTIONS
--============================================================

local lines = {}

local function log(message)

	table.insert(
		lines,
		tostring(message)
	)

	-- จำกัด log เพื่อไม่ให้ UI ใหญ่เกินไป
	if #lines > 300 then
		table.remove(lines, 1)
	end

	text.Text =
		table.concat(lines, "\n")

	task.defer(function()

		output.CanvasSize =
			UDim2.fromOffset(
				0,
				text.AbsoluteSize.Y + 20
			)

		output.CanvasPosition =
			Vector2.new(
				0,
				math.max(
					0,
					text.AbsoluteSize.Y
						- output.AbsoluteSize.Y
				)
			)
	end)
end

local function clearLog()
	table.clear(lines)
	text.Text = ""
end

--============================================================
-- SCAN / DUMP
--============================================================

local function scan()

	TARGETS = {}

	clearLog()

	log("========== SCAN ==========")

	local bases =
		CollectionService:GetTagged(
			"BrainrotBase"
		)

	log("Bases found: " .. #bases)

	local myBase = getMyBase()

	if myBase then

		HOME_POSITION =
			getBasePosition(myBase)

		log(
			"Home: "
			.. myBase:GetFullName()
		)

	else

		log("Home: NOT FOUND")
	end

	for _, base in ipairs(bases) do

		local owner =
			base:GetAttribute(
				"OwnerUserId"
			)

		log("")
		log(
			"BASE: "
			.. base:GetFullName()
		)

		log(
			"OwnerUserId: "
			.. tostring(owner)
		)

		local count = 0

		for _, object in ipairs(
			CollectionService:GetTagged(
				"Stealable"
			)
		) do

			if object:IsDescendantOf(base) then

				local available =
					object:GetAttribute(
						"Stealable"
					)

				if available ~= false then

					count += 1

					table.insert(
						TARGETS,
						{
							Base = base,
							Object = object
						}
					)

					log(
						"  ├─ "
						.. object.Name
						.. " [Stealable]"
					)
				end
			end
		end

		log(
			"Targets: "
			.. count
		)
	end

	log("")
	log(
		"Total targets: "
		.. #TARGETS
	)

	log("========== END ==========")

	status.Text =
		"Found "
		.. #TARGETS
		.. " target(s)"

	status.TextColor3 =
		Color3.fromRGB(
			100,
			220,
			130
		)
end

--============================================================
-- RETURN HOME
--============================================================

local function returnHome()

	local root = getRoot()

	if not root then
		status.Text = "Character not ready"
		return
	end

	if not HOME_POSITION then

		local base = getMyBase()

		if base then
			HOME_POSITION =
				getBasePosition(base)
		end
	end

	if not HOME_POSITION then

		status.Text =
			"Home position not found"

		return
	end

	root.CFrame =
		CFrame.new(
			HOME_POSITION
				+ Vector3.new(0, 3, 0)
		)

	status.Text =
		"Returned Home"

	status.TextColor3 =
		Color3.fromRGB(
			100,
			220,
			130
		)

	log("[HOME] Returned home")
end

--============================================================
-- AUTO TEST
--============================================================

local function autoTest()

	if RUNNING then
		return
	end

	RUNNING = true

	status.Text =
		"Auto Test running..."

	status.TextColor3 =
		Color3.fromRGB(
			255,
			200,
			80
		)

	-- Scan ก่อนทุกครั้ง
	scan()

	if #TARGETS == 0 then

		status.Text =
			"No target found"

		RUNNING = false
		return
	end

	local root = getRoot()

	if not root then

		status.Text =
			"Character not ready"

		RUNNING = false
		return
	end

	-- จำบ้านอีกครั้ง
	local base = getMyBase()

	if base then
		HOME_POSITION =
			getBasePosition(base)
	end

	for index, data in ipairs(TARGETS) do

		if not RUNNING then
			break
		end

		local object = data.Object

		if not object
			or not object.Parent then

			continue
		end

		local available =
			object:GetAttribute(
				"Stealable"
			)

		if available == false then
			continue
		end

		local position =
			getObjectPosition(object)

		if not position then
			continue
		end

		log("")
		log(
			"["
			.. index
			.. "/"
			.. #TARGETS
			.. "] Target: "
			.. object.Name
		)

		-- ไปยังเป้าหมาย
		root.CFrame =
			CFrame.new(
				position
					+ Vector3.new(0, 3, 0)
			)

		status.Text =
			"Testing: "
			.. object.Name

		task.wait(0.5)

		if not RUNNING then
			break
		end

		-- จำลองการเก็บ
		object:SetAttribute(
			"Stealable",
			false
		)

		object:SetAttribute(
			"CollectedBy",
			Player.UserId
		)

		log(
			"[COLLECTED] "
			.. object.Name
		)

		task.wait(0.4)

		-- กลับบ้านหลังเก็บ
		if HOME_POSITION then

			root.CFrame =
				CFrame.new(
					HOME_POSITION
						+ Vector3.new(0, 3, 0)
				)

			log(
				"[RETURN] Home"
			)
		end

		task.wait(0.5)
	end

	RUNNING = false

	status.Text =
		"Auto Test finished"

	status.TextColor3 =
		Color3.fromRGB(
			100,
			220,
			130
		)

	log("")
	log("========== FINISHED ==========")
end

