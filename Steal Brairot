local holding = false
RunService.Heartbeat:Connect(function()
    if not Config.AutoSteal then
        holding = false
        return
    end

    local prompt = findNearestPrompt()
    if not prompt then holding = false; return end

    if not holding then
        holding = true
        -- เริ่ม hold prompt
        pcall(function()
            -- วิธีที่ 1: fireproximityprompt ตรงๆ (executor function)
            fireproximityprompt(prompt)
        end)

        -- วิธีที่ 2: trigger ผ่าน holdDuration loop
        pcall(function()
            local holdTime = prompt.HoldDuration
            if holdTime <= 0 then
                -- กดครั้งเดียวพอ
                prompt.Triggered:Fire(LocalPlayer)
            else
                -- ต้องค้างไว้ตาม holdTime
                local elapsed = 0
                local conn
                conn = RunService.Heartbeat:Connect(function(dt)
                    if not Config.AutoSteal then conn:Disconnect(); holding=false; return end
                    elapsed = elapsed + dt
                    -- ส่ง InputBegan ซ้ำๆ เพื่อจำลองการค้าง
                    pcall(function() prompt:InputHoldBegin() end)
                    if elapsed >= holdTime + 0.1 then
                        pcall(function() prompt:InputHoldEnd() end)
                        conn:Disconnect()
                        task.wait(0.3)
                        holding = false
                    end
                end)
            end
        end)
    end
end)

