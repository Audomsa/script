-- ================================================
--  AUTO STEAL
-- ================================================
local function findNearestBrainrot()
    local myChar = LocalPlayer.Character
    if not myChar then return nil end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local best, bestDist = nil, math.huge

    -- สแกน workspace หา object ที่ชื่อมี "Brainrot" หรือ interact ได้
    for _, obj in ipairs(workspace:GetDescendants()) do
        -- หา ProximityPrompt (ปุ่ม E interact)
        if obj:IsA("ProximityPrompt") then
            local part = obj.Parent
            if part and part:IsA("BasePart") then
                local dist = (part.Position - myRoot.Position).Magnitude
                if dist < Config.StealRange and dist < bestDist then
                    best = obj
                    bestDist = dist
                end
            end
        end
    end
    return best
end

local stealCooldown = false
RunService.Heartbeat:Connect(function()
    if not Config.AutoSteal then return end
    if stealCooldown then return end

    local prompt = findNearestBrainrot()
    if not prompt then return end

    stealCooldown = true
    -- Fire ProximityPrompt เหมือนกด E
    pcall(function()
        fireproximityprompt(prompt)
    end)

    -- ถ้า fireproximityprompt ไม่มี ลองใช้วิธีอื่น
    pcall(function()
        local evnt = prompt:FindFirstChild("TriggerEnded") or prompt.Triggered
        if evnt then evnt:Fire(LocalPlayer) end
    end)

    task.wait(0.5) -- cooldown ป้องกัน spam
    stealCooldown = false
end)

