local function makeToggle(text,order,configKey)
    local row=Instance.new("Frame",Frame); row.Size=UDim2.new(1,0,0,28)
    row.BackgroundTransparency=1; row.LayoutOrder=order
    local lbl=Instance.new("TextLabel",row); lbl.Size=UDim2.new(0.65,0,1,0)
    lbl.BackgroundTransparency=1; lbl.Text=text; lbl.TextColor3=Color3.fromRGB(210,200,255)
    lbl.TextSize=12; lbl.Font=Enum.Font.GothamSemibold; lbl.TextXAlignment=Enum.TextXAlignment.Left
    local btn=Instance.new("TextButton",row); btn.Size=UDim2.new(0,44,0,22)
    btn.Position=UDim2.new(1,-44,0.5,-11); btn.BackgroundColor3=Color3.fromRGB(50,40,70)
    btn.Text=""; btn.AutoButtonColor=false
    Instance.new("UICorner",btn).CornerRadius=UDim.new(1,0)
    local circle=Instance.new("Frame",btn); circle.Size=UDim2.new(0,16,0,16)
    circle.Position=UDim2.new(0,3,0.5,-8); circle.BackgroundColor3=Color3.fromRGB(130,120,160)
    Instance.new("UICorner",circle).CornerRadius=UDim.new(1,0)
    local function refresh()
        if Config[configKey] then
            btn.BackgroundColor3=Color3.fromRGB(120,60,220)
            circle.BackgroundColor3=Color3.fromRGB(255,255,255)
            circle:TweenPosition(UDim2.new(1,-19,0.5,-8),"Out","Quad",0.12,true)
        else
            btn.BackgroundColor3=Color3.fromRGB(50,40,70)
            circle.BackgroundColor3=Color3.fromRGB(130,120,160)
            circle:TweenPosition(UDim2.new(0,3,0.5,-8),"Out","Quad",0.12,true)
        end
    end
    refresh()
    btn.MouseButton1Click:Connect(function() Config[configKey]=not Config[configKey]; refresh() end)
    return refresh
end

local function makeSlider(text,order,mn,mx,def,dec,configKey)
    local row=Instance.new("Frame",Frame); row.Size=UDim2.new(1,0,0,46)
    row.BackgroundTransparency=1; row.LayoutOrder=order
    local top=Instance.new("Frame",row); top.Size=UDim2.new(1,0,0,14); top.BackgroundTransparency=1
    local nl=Instance.new("TextLabel",top); nl.Size=UDim2.new(0.6,0,1,0); nl.BackgroundTransparency=1
